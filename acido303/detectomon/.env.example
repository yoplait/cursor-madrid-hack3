MODEL_PATH=models\LibreYOLOXs.pt
DEFAULT_CONFIDENCE=0.45
DEFAULT_SAMPLE_FPS=1
MAX_FRAME_WIDTH=640
MAX_FRAME_HEIGHT=480
# Set to 1 to use fake detections when no model is available
MOCK_DETECTION=0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
OPENAI_API_KEY=your-openai-api-key-here
# Optional: custom base URL for Azure OpenAI or compatible proxies
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# Image generation model (default: dall-e-3; set to dall-e-2 or provider equivalent)
IMAGE_MODEL=gpt-image-1